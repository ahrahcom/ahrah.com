# Copy this file to .env and fill in the mail settings.
# Never commit .env. The API reads environment variables first, then this file.

# production refuses to start unless MAIL_MODE=smtp
NODE_ENV=development
# Listen on localhost unless a firewall or reverse proxy is in front.
HOST=127.0.0.1
PORT=8787

# The site is served by CloudFront. This API stays on the server.
# These are the site addresses a browser may call from, not the API host.
# Add the raw https://xxxx.cloudfront.net address only while testing, then remove it.
ALLOWED_ORIGINS=https://ahrah.com,https://www.ahrah.com

# On the server, keep the API on localhost and let Caddy or nginx
# terminate HTTPS for api.ahrah.com and proxy to this port.
# Set TRUST_PROXY=1 only in that case. Otherwise a visitor can fake their IP.
TRUST_PROXY=0

# Set to 1 on the HTTPS server. Do not enable it for local http.
HSTS=0

# smtp sends mail. log prints "enquiry accepted" and is blocked in production.
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ahrah <business@ahrah.com>"
MAIL_TO=business@ahrah.com

BODY_LIMIT=8192
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=900000
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_MS=3600000
