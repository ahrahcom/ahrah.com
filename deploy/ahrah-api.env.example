# Copy to /opt/ahrah-api/.env on the server. Do not commit the real file.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=https://ahrah.com,https://www.ahrah.com
TRUST_PROXY=1
HSTS=0

MAIL_MODE=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ahrah <notify@ahrah.com>"
MAIL_TO=harsika@ahrah.com

BODY_LIMIT=8192
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=900000
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_MS=3600000
